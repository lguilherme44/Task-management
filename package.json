{
  "name": "task-management",
  "version": "2.0.0",
  "private": true,
  "description": "A modern, beautiful, responsive task manager. First-ever project, reborn.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:api": "pnpm --filter @task/api dev",
    "dev:web": "pnpm --filter @task/web dev",
    "build": "pnpm -r run build",
    "start": "pnpm --filter @task/api start",
    "setup": "pnpm install && pnpm --filter @task/api db:setup",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/dist apps/api/prisma/dev.db*"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
